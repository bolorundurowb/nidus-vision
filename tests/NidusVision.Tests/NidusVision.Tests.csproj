<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>14</LangVersion>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);OmniAssert.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="OmniAssert" Version="2.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="OmniAssert" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NidusVision.Core\NidusVision.Core.csproj" />
    <ProjectReference Include="..\..\src\NidusVision.Data\NidusVision.Data.csproj" />
    <ProjectReference Include="..\..\src\NidusVision.Streaming\NidusVision.Streaming.csproj" />
    <ProjectReference Include="..\..\src\NidusVision.Inference\NidusVision.Inference.csproj" />
    <ProjectReference Include="..\..\src\NidusVision.Web\NidusVision.Web.csproj" />
  </ItemGroup>

</Project>